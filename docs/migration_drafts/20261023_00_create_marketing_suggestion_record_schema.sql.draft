-- 2026-10-23 마케팅 AI M4-full 초안 — 채택한 제안(상품명·검색어·가격)을 쿠팡 옵션 ID에 연결해 기록하는 신규 테이블 1개(추가형).
-- 이 파일은 초안이다. 실제 DB에는 적용하지 않았고, Model(app/domains/.../model.py)도 아직 없다.
-- 적용하려면: ① 사용자 승인 ② Model 작성 ③ Model↔SQL 대조(canonical DDL diff) ④ 임시 DB 적용·재적용 실패·rollback 검증 ⑤ 백업 후 앱의 Migration 승인 경로
--           ⑥ 이 파일을 migrations/ 로 옮기고 확장자를 .sql 로 바꾼다. (migrations/ 에 두는 순간 앱 시작 때 승인 대기 Migration으로 잡힌다.)
-- 기존 테이블·데이터는 건드리지 않는다. 비밀값·고객 개인정보 없음(제안 문구와 옵션 ID만).
--
-- rollback(자동 실행되지 않음):
--   DROP INDEX IF EXISTS ix_marketing_suggestion_records_vendor_item_id;
--   DROP INDEX IF EXISTS ix_marketing_suggestion_records_company_id;
--   DROP TABLE IF EXISTS marketing_suggestion_records;
-- =========================================================

BEGIN;

CREATE TABLE marketing_suggestion_records (
	id INTEGER NOT NULL,
	company_id INTEGER NOT NULL,
	kind VARCHAR(20) NOT NULL,
	vendor_item_id VARCHAR(40),
	product_ref VARCHAR(80),
	suggested_value VARCHAR(300) NOT NULL,
	suggested_at DATETIME NOT NULL,
	adopted BOOLEAN NOT NULL,
	adopted_at DATETIME,
	created_by INTEGER,
	created_at DATETIME NOT NULL,
	PRIMARY KEY (id),
	CONSTRAINT ck_marketing_suggestion_records_kind CHECK (kind IN ('PRODUCT_NAME', 'SEARCH_KEYWORD', 'PRICE'))
);

CREATE INDEX ix_marketing_suggestion_records_company_id ON marketing_suggestion_records (company_id);

CREATE INDEX ix_marketing_suggestion_records_vendor_item_id ON marketing_suggestion_records (vendor_item_id);

COMMIT;
