+        self.assertNotIn('id="${prefix}-option"><input', picker)
+        self.assertNotRegex(picker, r'<input[^>]*id="\$\{prefix\}-option"')
+        wiring = self.js[self.js.index("function olWirePicker"):self.js.index("// ---------------- 매입 검토 화면")]
